# —— 基础 ——
DB_PATH=./data/jobhunter.db
# 生产必填（≥32 位随机串；缺失/示例值会拒绝启动）；本地开发可不配
JWT_SECRET=change-me-to-a-random-32-char-secret
# 演示账号密码（npm run db:seed 用，默认 demo12345）
DEMO_PASSWORD=demo12345
# 登录模式：本地开发（npm run dev）默认「本地单用户」免登录直达工作台；
# 设为 login 恢复登录页流程。生产环境始终强制登录，不受此项影响。
# AUTH_MODE=login

# —— AI ——
AI_PROVIDER=mock            # mock | openai（OpenAI 兼容端点：GLM/DeepSeek/Kimi/Qwen 等）
AI_DAILY_LIMIT=200
# AI_PROVIDER=openai 时的全局兜底配置；用户在「设置→自备模型」配置后优先生效（无需此项）
AI_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=glm-4-flash
AI_OPENAI_EMBED_MODEL=embedding-3
# 开放注册部署建议设为 off：未自备 Key 的注册用户不再回落全局 env Key（防成本滥用），回落为 mock 演示模式；
# 默认 on 保持单机自用体验
AI_OPENAI_FALLBACK=on

# —— Agent ——
AGENT_DRIVER=mock           # mock | （真实浏览器驱动为后续版本能力）

# —— 安全 ——
# 加密用户自带 API Key 的主密钥（AES-256-GCM）。生产必须显式配置 32+ 位随机串；
# 未配置时从 JWT_SECRET 派生（仅限本地开发，换 JWT_SECRET 会导致已存 Key 解不开，重新保存即可）
AI_KEY_MASTER_SECRET=
